{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // Stryker's "command" test runner ships inside @stryker-mutator/core; this package name does not exist on npm.
      "ignoreDependencies": ["@stryker-mutator/command-runner"]
    },
    "vscode-extension": {
      "entry": ["src/extension.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
