{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["coverage/**", "reports/**", ".stryker-tmp/**"],
  "rules": {
    "eqeqeq": "error",
    "max-classes-per-file": ["error", 1],
    "no-console": "error",
    "import/no-cycle": "error",
    "unicorn/prefer-node-protocol": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-deprecated": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^\\.\\./",
            "message": "Imports must use the #domain/ #command/ #io/ #cli/ #builtin/ #api/ aliases, or @svgframe/api in a plugin."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "app/**/*.ts", "plugins/*/src/**/*.ts"],
      "excludeFiles": ["src/api/index.ts", "app/main.ts"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "pascalCase"
          }
        ]
      }
    },
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "Imports must use the #domain/ #command/ #io/ #cli/ #builtin/ #api/ aliases, or @svgframe/api in a plugin."
              },
              {
                "regex": "^#host/",
                "message": "The kernel must not depend on the assembly code in app/."
              },
              {
                "regex": "^@svgframe/",
                "message": "The kernel must not depend on plugins or on the plugin API package name."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "Imports must use the #domain/ #command/ #io/ #cli/ #builtin/ #api/ aliases, or @svgframe/api in a plugin."
              },
              {
                "regex": "^#host/",
                "message": "The kernel must not depend on the assembly code in app/."
              },
              {
                "regex": "^@svgframe/",
                "message": "The kernel must not depend on plugins or on the plugin API package name."
              },
              {
                "regex": "^#(command|io|cli|builtin|api)/",
                "message": "domain must not depend on any other module."
              },
              {
                "regex": "^(node:|bun(:|$)|commander$|@commander-js/|fast-xml-)",
                "message": "domain does no IO and uses no libraries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/io/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "Imports must use the #domain/ #command/ #io/ #cli/ #builtin/ #api/ aliases, or @svgframe/api in a plugin."
              },
              {
                "regex": "^#host/",
                "message": "The kernel must not depend on the assembly code in app/."
              },
              {
                "regex": "^@svgframe/",
                "message": "The kernel must not depend on plugins or on the plugin API package name."
              },
              {
                "regex": "^#(command|cli|builtin|api)/",
                "message": "io may only depend on domain."
              },
              {
                "regex": "^(bun(:|$)|commander$)",
                "message": "io uses node:fs and the fast-xml packages only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/command/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "Imports must use the #domain/ #command/ #io/ #cli/ #builtin/ #api/ aliases, or @svgframe/api in a plugin."
              },
              {
                "regex": "^#host/",
                "message": "The kernel must not depend on the assembly code in app/."
              },
              {
                "regex": "^@svgframe/",
                "message": "The kernel must not depend on plugins or on the plugin API package name."
              },
              {
                "regex": "^#(cli|builtin|api)/",
                "message": "command must not depend on cli, builtin or api."
              },
              {
                "regex": "^(node:|bun(:|$)|commander$|@commander-js/|fast-xml-)",
                "message": "command reaches files and XML only through io."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/cli/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "Imports must use the #domain/ #command/ #io/ #cli/ #builtin/ #api/ aliases, or @svgframe/api in a plugin."
              },
              {
                "regex": "^#host/",
                "message": "The kernel must not depend on the assembly code in app/."
              },
              {
                "regex": "^@svgframe/",
                "message": "The kernel must not depend on plugins or on the plugin API package name."
              },
              {
                "regex": "^#(io|builtin|api)/",
                "message": "cli reaches files only through commands, and commands only through the registry."
              },
              {
                "regex": "^(node:fs|fast-xml-)",
                "message": "cli does not touch files or XML."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/builtin/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "Imports must use the #domain/ #command/ #io/ #cli/ #builtin/ #api/ aliases, or @svgframe/api in a plugin."
              },
              {
                "regex": "^#host/",
                "message": "The kernel must not depend on the assembly code in app/."
              },
              {
                "regex": "^@svgframe/",
                "message": "The kernel must not depend on plugins or on the plugin API package name."
              },
              {
                "regex": "^#(cli|io|api)/",
                "message": "builtin may only depend on domain and command."
              },
              {
                "regex": "^(node:|bun(:|$)|commander$|@commander-js/|fast-xml-)",
                "message": "builtin uses no libraries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/**/*.ts", "test/fixtures/plugins/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "Imports must use the #domain/ #command/ #io/ #cli/ #builtin/ #api/ aliases, or @svgframe/api in a plugin."
              },
              {
                "regex": "^#",
                "message": "A plugin may import the kernel only through @svgframe/api."
              },
              {
                "regex": "^@svgframe/plugin-",
                "message": "A plugin must not depend on another plugin."
              },
              {
                "regex": "^@svgframe/testing$",
                "message": "Only plugin tests may use the test doubles."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "Imports must use the #domain/ #command/ #io/ #cli/ #builtin/ #api/ aliases, or @svgframe/api in a plugin."
              },
              {
                "regex": "^#",
                "message": "A plugin may import the kernel only through @svgframe/api."
              },
              {
                "regex": "^@svgframe/plugin-",
                "message": "A plugin must not depend on another plugin."
              }
            ]
          }
        ]
      }
    }
  ]
}
