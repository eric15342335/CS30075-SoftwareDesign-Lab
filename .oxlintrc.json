{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["coverage/**", "reports/**", ".stryker-tmp/**"],
  "rules": {
    "eqeqeq": "error",
    "max-classes-per-file": ["error", 1],
    "no-console": "error",
    "import/no-cycle": "error",
    "unicorn/prefer-node-protocol": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-deprecated": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^\\.\\./",
            "message": "Imports must use the #domain/ #command/ #io/ #cli/ #builtin/ #api/ aliases, or @svgframe/api in a plugin."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "app/**/*.ts", "plugins/*/src/**/*.ts"],
      "excludeFiles": ["src/api/index.ts", "app/main.ts"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "pascalCase"
          }
        ]
      }
    },
    {
      "files": ["src/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!#domain/*"],
                "message": "domain imports only domain: no IO, no libraries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/io/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!#domain/*",
                  "!#io/*",
                  "!node:fs",
                  "!fast-xml-parser",
                  "!fast-xml-validator",
                  "!fast-xml-builder"
                ],
                "message": "io imports only domain, node:fs and the fast-xml packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/command/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!#domain/*", "!#io/*", "!#command/*"],
                "message": "command imports only domain and io."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/cli/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!#domain/*",
                  "!#command/*",
                  "!#cli/*",
                  "!commander",
                  "!@commander-js/*",
                  "!node:*",
                  "node:fs"
                ],
                "message": "cli imports only command, domain, commander and node:* modules other than node:fs."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/builtin/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!#domain/*", "!#command/*", "!#builtin/*"],
                "message": "builtin imports only domain and command, and no libraries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!#domain/*", "!#command/*", "!#api/*"],
                "message": "api imports only domain and command."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/**/*.ts", "test/fixtures/plugins/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!@svgframe/api", "!node:*", "!./*"],
                "message": "A plugin imports only @svgframe/api, node:* modules and its own files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!@svgframe/api",
                  "!@svgframe/testing",
                  "!bun:test",
                  "!node:*",
                  "!./*"
                ],
                "message": "A plugin test imports only @svgframe/api, @svgframe/testing, bun:test, node:* modules and its own files."
              }
            ]
          }
        ]
      }
    }
  ]
}
